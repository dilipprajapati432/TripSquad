PORT=5000

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/tripsquad

# Any long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Where the React app runs (for CORS)
CLIENT_URL=http://localhost:5173

# Max people per trip
MAX_MEMBERS=30

# Sent to OpenStreetMap with place searches (their usage policy asks for contact info)
CONTACT_EMAIL=you@example.com

# AI planner: fill ONE of these (Gemini is used if both are set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
